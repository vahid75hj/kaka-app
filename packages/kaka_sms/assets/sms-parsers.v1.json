    {
      "bank_id": "melli",
      "name": {
        "en": "Bank Melli Iran",
        "fa": "بانک ملی"
      },
      "senders": [],
      "templates": [
        {
          "id": "melli.v1",
          "regex": "(?:بانک ?ملی|ملی)[\\s\\S]*?(?<direction>برداشت|واریز|خرید|انتقال)[^\\d]*(?<amount>[\\d,٬]+)[\\s\\S]*?(?:حساب|کارت)[^\\d]*(?<last4>\\d{4})\\b[\\s\\S]*?مانده[^\\d]*(?<balance>[\\d,٬]+)(?:[\\s\\S]*?(?<date>\\d{2,4}/\\d{2}/\\d{2})(?:[-\\s]+(?<time>\\d{1,2}:\\d{2}))?)?",
          "debit_words": [
            "برداشت",
            "خرید",
            "انتقال"
          ],
          "credit_words": [
            "واریز"
          ]
        }
      ],
      "tests": [
        {
          "input": "بانک ملی ایران\nبرداشت: 1,200,000\nحساب: 0123\nمانده: 15,300,000\n1405/08/01-12:30",
          "expect": {
            "direction": "debit",
            "amount_minor": 1200000,
            "balance_minor": 15300000,
            "last4": "0123"
          }
        },
        {
          "input": "بانک ملی\nواریز: ۲۵۰٬۰۰۰\nحساب: ۹۸۷۶\nمانده: ۳٬۱۰۰٬۰۰۰\n۱۴۰۵/۰۸/۰۲-۰۹:۱۵",
          "expect": {
            "direction": "credit",
            "amount_minor": 250000,
            "balance_minor": 3100000,
            "last4": "9876"
          }
        }
      ],
      "status": "needs_samples",
      "note": "Templates are based on publicly circulated formats and are UNVERIFIED. Please contribute masked real samples."
    },
